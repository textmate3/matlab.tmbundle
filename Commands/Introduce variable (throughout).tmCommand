<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/usr/bin/env python3
"""Pull the selection out into a variable, replacing it everywhere.

The assignment goes above the first line that mentions the selection.
"""

import os
import sys

sys.path.append(os.path.join(os.environ['TM_SUPPORT_PATH'], 'lib'))

import dialog


def first_line_containing(lines, text):
    for number, line in enumerate(lines):
        if text in line:
            return number
    return 0


lines = sys.stdin.readlines()
selection = os.environ.get('TM_SELECTED_TEXT')

if selection:
    name = dialog.get_string(title='Introduce Variable', prompt='Variable name:') or 'var'
    terminator = os.environ.get('TM_LINE_TERMINATOR') or ';'

    # The assignment has to come before anything that uses it, and the old
    # version subtracted one from the line it found, which put it above the
    # wrong line and out of the document entirely when the match was first.
    insert_at = first_line_containing(lines, selection)
    lines = [line.replace(selection, name) for line in lines]
    lines.insert(insert_at, '%s = %s%s\n' % (name, selection, terminator))

sys.stdout.writelines(lines)</string>
	<key>input</key>
	<string>document</string>
	<key>keyEquivalent</key>
	<string>^C</string>
	<key>name</key>
	<string>Introduce variable (throughout)</string>
	<key>output</key>
	<string>replaceDocument</string>
	<key>scope</key>
	<string>source.matlab,source.python</string>
	<key>uuid</key>
	<string>4B350792-24A2-4083-A8FB-509DF4BD709A</string>
</dict>
</plist>
